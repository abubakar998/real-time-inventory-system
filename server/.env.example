# --- Database -------------------------------------------------------------
# Local:  postgres://postgres:postgres@localhost:5432/inventory
# Neon:   postgres://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/inventory

# Force TLS on. Auto-enabled when the URL contains sslmode=require or a known
# managed-Postgres host (neon.tech, supabase, render.com, ...).
# PGSSL=true

# --- Server ---------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed browser origins for CORS + Socket.io.
CLIENT_ORIGIN=http://localhost:5173

# --- Inventory tuning -----------------------------------------------------
# Default reservation hold window for newly created drops (seconds).
RESERVATION_TTL_SECONDS=60

# How often the background sweeper reclaims expired reservations (ms).
# This is the correctness backstop; per-reservation timers handle low latency.
SWEEP_INTERVAL_MS=2000

# --- Admin ----------------------------------------------------------------
# If set, POST /api/drops requires header:  x-admin-token: <value>
# Leave blank to keep the drop-creation API open. The browser client does not
# send this header, so setting it makes the "New drop" panel 403 and turns drop
# creation into a curl-only operation.
ADMIN_TOKEN=

# Set to true to log every SQL statement.
SQL_LOG=false
